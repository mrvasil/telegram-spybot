# BotFather token and numeric ID of the only owner.
TOKEN=
USER_ID=
# Local path; never share or commit this directory.
DATA_DIR=./data
# Absolute path to a 600-permission file OUTSIDE DATA_DIR. Created by spybot init.
ARCHIVE_KEY_FILE=/absolute/path/to/archive.key
TIMEZONE=Europe/Moscow
# 0 = keep indefinitely. Deletion is opt-in.
RETENTION_DAYS=0
MEDIA_WORKERS=3
MAX_FILE_BYTES=2000000000
MIN_FREE_BYTES=268435456
BACKUP_HOURS=24
BACKUP_KEEP=7
BOT_API_URL=https://api.telegram.org
# Docker: set these to `id -u` and `id -g` on the host.
RUN_UID=1000
RUN_GID=1000
